pipelines/**/env.yaml
pipelines/**/env.*.yaml
!pipelines/**/env*example*.yaml

# Generated pipeline output (reports, notebooks, exports) — regenerate locally, don't commit.
pipelines/**/products/

# Python
__pycache__/
*.pyc
